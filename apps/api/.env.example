# Copy to .env for `pnpm dev` (the file is gitignored). With Docker, pass these
# to the api service instead (see docker-compose.yml).

# Postgres. `docker compose up -d db` starts one matching this.
DATABASE_URL=postgres://blob:blob@localhost:5432/blob_land
# Signs players' sessions. Anything long and random: `openssl rand -hex 32`.
# Outside local dev (DEV_TOOLS) the server refuses one under 32 characters.
JWT_SECRET=change-me
# PORT=8787
# DB_POOL_SIZE=10
# Sign-ups and logins allowed per IP per minute.
# AUTH_RATE_LIMIT=20
# Behind a reverse proxy (Caddy, nginx, Traefik): take the IP from X-Forwarded-For.
# TRUST_PROXY=1

# Local dev only, never in production: opens /__dev/* to anyone.
DEV_TOOLS=1
# TIME_SCALE=10
