{
  "name": "@blob-land/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "dev:cron": "node -e \"setInterval(() => fetch('http://localhost:8787/__scheduled').catch(() => {}), 60000)\"",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:apply": "wrangler d1 execute blob-land --local --file=schema.sql",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@blob-land/sim": "workspace:*",
    "blobatar": "^2.7.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^3.80.0"
  }
}
