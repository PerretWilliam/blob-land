{
  "name": "@blob-land/api",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/main.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env -e \"import('./src/db.ts').then((db) => db.migrate().then(() => db.client.end()))\"",
    "seed": "node scripts/seed.mjs",
    "load": "node scripts/load.mjs"
  },
  "dependencies": {
    "@blob-land/sim": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "blobatar": "^2.7.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
