{
  "name": "blob-land",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel run \"/^dev/\"",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "sim:test": "pnpm --filter @blob-land/sim test",
    "api:dev": "pnpm --filter @blob-land/api dev",
    "api:test": "pnpm --filter @blob-land/api test",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.35.4": "^0.35.4"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7"
  }
}
